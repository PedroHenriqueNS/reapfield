---
/**
 * Terminal chrome. The content is real output copied from README.md, not a
 * mocked-up product UI. For a CLI, the terminal is the product surface.
 */
interface Props {
  label: string;
  class?: string;
}
const { label, class: cls = "" } = Astro.props;
---

<div class:list={["term", cls]}>
  <div class="term__bar">
    <span>{label}</span>
  </div>
  <pre class="term__body"><code><slot /></code></pre>
</div>
